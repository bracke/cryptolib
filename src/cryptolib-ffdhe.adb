      if Natural (Private_Value'Length) /= Exponent_Length (Group)
        or else Natural (Public_Value'Length) /= Value_Length (Group)
      then
         return Handshake_Failed;
      end if;

      for Attempt in 1 .. Attempts loop
         if CryptoLib.Random.Fill (Rng, Private_Value) /= Ok then
            Private_Value := [others => 0];
            return Internal_Error;
         end if;
         if Usable_Exponent (Private_Value) then
            return Result : constant CryptoLib.Errors.Status :=
              CryptoLib.FFDHE.Public_Value
                (Group, Private_Value, Public_Value)
            do
               if Result /= Ok then
                  Private_Value := [others => 0];
               end if;
            end return;
         end if;
      end loop;

      Private_Value := [others => 0];
      return Internal_Error;
   exception
      when others =>
         Private_Value := [others => 0];
         Public_Value := [others => 0];
         return Internal_Error;
   end Generate_Keypair;

   function Shared_Secret
     (Group         : Group_Id;
      Private_Value : Ada.Streams.Stream_Element_Array;
      Peer_Value    : Ada.Streams.Stream_Element_Array;
      Secret        : out Ada.Streams.Stream_Element_Array)
      return CryptoLib.Errors.Status
   is
      use System;
   begin
      Secret := [others => 0];
      if Natural (Secret'Length) /= Value_Length (Group)
        or else Natural (Private_Value'Length) /= Exponent_Length (Group)
      then
         return Handshake_Failed;
      end if;

      --  The peer value is checked before the exponent touches it.
      if not In_Range (Group, Peer_Value) then
         return Authentication_Failed;
      end if;
      if not Usable_Exponent (Private_Value) then
         return Authentication_Failed;
      end if;

      Secret :=
        CryptoLib.Modexp.Mod_Exp (Peer_Value, Private_Value, Prime (Group));

      --  A secret of 1 or p-1 means the peer value had order 1 or 2 despite
      --  the range check. Unreachable as far as the checks above allow, and
      --  refused rather than trusted not to happen.
      if not In_Range (Group, Secret) then
         CryptoLib.Secure_Wipe.Wipe (Secret'Address, Secret'Length);
         Secret := [others => 0];
         return Authentication_Failed;
      end if;
      return Ok;
   exception
      when others =>
         Secret := [others => 0];
         return Internal_Error;
   end Shared_Secret;

end CryptoLib.FFDHE;
