   --  The generator is 2 for every RFC 7919 group.
   Generator : constant Octets (1 .. 1) := [1 => 2];

   function Prime (Group : Group_Id) return Octets is
     (case Group is
         when FFDHE2048 => P2048,
         when FFDHE3072 => P3072,
         when FFDHE4096 => P4096,
         when FFDHE6144 => P6144,
         when FFDHE8192 => P8192);

   function Value_Length (Group : Group_Id) return Positive is
     (case Group is
         when FFDHE2048 => 256,
         when FFDHE3072 => 384,
         when FFDHE4096 => 512,
         when FFDHE6144 => 768,
         when FFDHE8192 => 1024);

   --  RFC 7919 appendix A puts the floor at 225 bits for ffdhe2048 rising to
   --  400 for ffdhe8192; these are the next whole multiples of 8 above that,
   --  with room to spare.
   function Exponent_Length (Group : Group_Id) return Positive is
     (case Group is
         when FFDHE2048 => 32,
         when FFDHE3072 => 40,
         when FFDHE4096 => 48,
         when FFDHE6144 => 56,
         when FFDHE8192 => 56);

   --  Is Value strictly between one and p-1?
   --
   --  Compared as fixed-width big-endian octets, which both operands are, so
   --  this is a plain lexicographic comparison. Not constant-time and it does
   --  not need to be: the peer value is public and so is the prime.
   function In_Range (Group : Group_Id; Value : Octets) return Boolean is
      P : constant Octets := Prime (Group);

      function Below_Prime_Minus_One return Boolean is
         Borrow : Stream_Element := 1;
         Limit  : Octets (P'Range);
      begin
         --  p - 1, computed rather than stored: p ends in 16#FF#, so the
         --  subtraction cannot borrow past the last octet, but it is written
         --  as a general borrow chain rather than relying on that.
         for I in reverse P'Range loop
            if P (I) >= Borrow then
               Limit (I) := P (I) - Borrow;
               Borrow := 0;
            else
               Limit (I) := P (I) - Borrow;
               Borrow := 1;
            end if;
         end loop;
         for I in P'Range loop
            declare
               L : constant Stream_Element := Value (Value'First + (I - P'First));
            begin
               if L /= Limit (I) then
                  return L < Limit (I);
               end if;
            end;
         end loop;
         return False;   --  equal to p-1
      end Below_Prime_Minus_One;

      Significant : Natural := 0;
   begin
      if Value'Length /= P'Length then
         return False;
      end if;
      for B of Value loop
         if B /= 0 then
            Significant := Significant + 1;
         end if;
      end loop;
      --  Y = 0 and Y = 1 are the elements of order 1; both are refused.
      if Significant = 0
        or else (Significant = 1 and then Value (Value'Last) = 1)
      then
         return False;
      end if;
      return Below_Prime_Minus_One;
   end In_Range;

   function Valid_Peer_Value
     (Group      : Group_Id;
      Peer_Value : Ada.Streams.Stream_Element_Array) return Boolean
   is (In_Range (Group, Peer_Value));

   --  Is this exponent usable? Zero and one are refused; anything else is
   --  below the group order by construction, because the exponent is far
   --  narrower than the prime.
   function Usable_Exponent (Value : Octets) return Boolean is
      Significant : Natural := 0;
   begin
      for B of Value loop
         if B /= 0 then
            Significant := Significant + 1;
         end if;
      end loop;
      return Significant > 1
        or else (Significant = 1 and then Value (Value'Last) > 1);
   end Usable_Exponent;

   function Public_Value
     (Group         : Group_Id;
      Private_Value : Ada.Streams.Stream_Element_Array;
      Public_Value  : out Ada.Streams.Stream_Element_Array)
      return CryptoLib.Errors.Status
   is
   begin
      Public_Value := [others => 0];
      if Natural (Public_Value'Length) /= Value_Length (Group)
        or else Natural (Private_Value'Length) /= Exponent_Length (Group)
      then
         return Handshake_Failed;
      end if;
      if not Usable_Exponent (Private_Value) then
         return Authentication_Failed;
      end if;
      Public_Value :=
        CryptoLib.Modexp.Mod_Exp (Generator, Private_Value, Prime (Group));
      return Ok;
   exception
      when others =>
         Public_Value := [others => 0];
         return Internal_Error;
   end Public_Value;

