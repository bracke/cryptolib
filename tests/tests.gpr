with "config/tests_config.gpr";
with "cryptolib.gpr";
project Tests is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("tests.adb");

   --  -gnatwM: no "useless assignment" warnings, and only in this crate. A
   --  negative test calls an operation for its status alone and leaves the out
   --  buffer uninspected on purpose, which is exactly the shape this warning
   --  reports. It stayed quiet while the suite was one 17k-line procedure and
   --  appeared the moment that procedure became packages -- the code did not
   --  change, only the scope GNAT analyses.
   --
   --  All 42 sites were read before this was added. 37 are refusals: a tamper
   --  test, a malformed input, a rejected key width. The other five are
   --  positive tests that assert on something other than the value the warning
   --  names -- a decode status left uninspected because the assertion is about
   --  what was decoded, an empty plaintext with nothing to compare. None was a
   --  missing assertion. The library's own build never sees this switch and
   --  still holds the zero-warning bar with the warning on.
   package Compiler is
      for Default_Switches ("Ada") use Tests_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnatwU", "-gnatwM");
   end Compiler;


   --  Bytes out as bytes in. Alire's generated switches carry -gnatW8 and the
   --  binder takes its run-time encoding from the same place, which makes
   --  Ada.Text_IO encode every byte above 127 a second time on the way out:
   --  text that was already UTF-8 -- an accented path, an internationalized
   --  domain name, a translated message -- came out doubled. -Wb is the
   --  compiler default and leaves the bytes alone.
   package Binder is
      for Switches ("Ada") use ("-Es", "-Wb"); --  Symbolic traceback
   end Binder;

   --  The library links nothing beyond the Ada runtime; the harness links
   --  OpenSSL so the suite can cross-check what this crate produces against an
   --  independent implementation.
   package Linker is
      for Default_Switches ("Ada") use ("-lcrypto");
   end Linker;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Tests;
