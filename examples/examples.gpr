with "../cryptolib.gpr";

--  Compilable counterparts of the snippets in README.md. The release preflight
--  builds these, so an example that stops compiling is caught.
project Examples is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use
     ("example_argon2.adb",
      "example_certificates.adb",
      "example_chacha20_poly1305.adb",
      "example_curve25519.adb",
      "example_ecdh.adb",
      "example_ed25519.adb",
      "example_rsa.adb",
      "example_tls13_kdf.adb",
      "example_hashes.adb",
      "example_macs.adb",
      "example_random.adb",
      "example_secure_wipe.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatyM120", "-gnatwa");
   end Compiler;
   --  Bytes out as bytes in. Alire's generated switches carry -gnatW8 and the
   --  binder takes its run-time encoding from the same place, which makes
   --  Ada.Text_IO encode every byte above 127 a second time on the way out:
   --  text that was already UTF-8 -- an accented path, an internationalized
   --  domain name, a translated message -- came out doubled. -Wb is the
   --  compiler default and leaves the bytes alone.
   package Binder is
      for Switches ("Ada") use ("-Wb");
   end Binder;

end Examples;
