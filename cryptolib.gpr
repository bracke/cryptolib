with "config/cryptolib_config.gpr";
project Cryptolib is

   for Library_Name use "Cryptolib";
   for Library_Version use Project'Library_Name & ".so." & Cryptolib_Config.Crate_Version;

   --  Per-OS backend directory (e.g. src-linux / src-windows) selected by the
   --  Alire host OS; holds the platform CryptoLib.OS_Random body.
   --  The AES and GHASH instructions a processor has: x86-64's, or none.
   Arch_Dir := "src-arch-generic/";
   case Cryptolib_Config.Alire_Host_Arch is
      when "x86_64" => Arch_Dir := "src-arch-x86_64/";
      when others => null;
   end case;
   for Source_Dirs use ("src/", "config/", "src-" & Cryptolib_Config.Alire_Host_OS & "/", Arch_Dir);
   for Object_Dir use "obj/" & Cryptolib_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("CRYPTOLIB_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use Cryptolib_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnatwU");
      --  ChaCha20's rounds: arithmetic only, and slow at the debug level the
      --  rest is built at.
      for Switches ("cryptolib-chacha20_poly1305.adb") use
        Cryptolib_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnatwU", "-O3", "-gnatVn");
      --  Only this body uses the instructions, and only once CPUID has said
      --  they are there.
      case Cryptolib_Config.Alire_Host_Arch is
         when "x86_64" =>
            for Switches ("cryptolib-ciphers-hardware.adb") use
              Cryptolib_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnatwU", "-maes", "-mpclmul", "-O2");
            for Switches ("cryptolib-hashes-hardware.adb") use
              Cryptolib_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnatwU", "-msha", "-O2");
         when others => null;
      end case;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Cryptolib;
