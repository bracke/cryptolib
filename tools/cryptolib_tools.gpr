with "config/cryptolib_tools_config.gpr";

--  Verification tooling for the cryptolib crate. Built on the shared
--  project_tools helpers. Run from the cryptolib crate root so the checks see
--  cryptolib's own src/, tests/, and alire.toml.
project Cryptolib_Tools is

   for Source_Dirs use (".", "config");
   for Object_Dir use "obj/" & Cryptolib_Tools_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";

   for Main use
     ("check_release_ready.adb",
      "check_alire_manifest.adb",
      "check_test_suite.adb",
      "check_gnatdoc_tags.adb",
      "check_constant_time.adb");

   package Compiler is
      --  -gnatyM120 is not decoration: Ada_Compiler_Switches brings -gnatym,
      --  whose default limit is 80, and the workspace standard is 120.
      for Default_Switches ("Ada") use
        Cryptolib_Tools_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnatyM120", "-gnata", "-Wall", "-Wextra");
   end Compiler;


   --  Bytes out as bytes in. Alire's generated switches carry -gnatW8 and the
   --  binder takes its run-time encoding from the same place, which makes
   --  Ada.Text_IO encode every byte above 127 a second time on the way out:
   --  text that was already UTF-8 -- an accented path, an internationalized
   --  domain name, a translated message -- came out doubled. -Wb is the
   --  compiler default and leaves the bytes alone.
   package Binder is
      for Switches ("Ada") use ("-Es", "-Wb"); --  Symbolic traceback
   end Binder;

end Cryptolib_Tools;
